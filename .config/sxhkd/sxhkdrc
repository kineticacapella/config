# =============================================================================
# WM & Core Shortcuts
# =============================================================================

# Terminal
super + Return
	wezterm

# Program Launcher (Rofi / Dmenu)
super + d
	rofi -show drun
	
super + Tab
	rofi -show window

# Open XMenu on empty desktop right-click
~button3
	if [ -z "$(xdotool getwindowfocus 2>/dev/null)" ]; then ~/.config/bspwm/scripts/xmenu.sh; fi

# Reload sxhkd configuration
super + Escape
	pkill -USR1 -x sxhkd

# Quit bspwm
super + shift + e
	bspc quit

# Restart bspwm
super + shift + r
	bspc wm -r

# Close window
super + shift + q
	bspc node -c

# Kill window forcefully
super + shift + a
	bspc node -k

# Lock screen
super + shift + x
	slock

# Launch Flameshot
super + Print
	flameshot gui

# =============================================================================
# Window Navigation & Movement
# =============================================================================

# Focus window in given direction (hjkl & arrows)
super + {h,j,k,l}
	bspc node -f {west,south,north,east}

super + {Left,Down,Up,Right}
	bspc node -f {west,south,north,east}

# Move window in given direction (Shift + hjkl & arrows)
super + shift + {h,j,k,l}
	bspc node -s {west,south,north,east}

super + shift + {Left,Down,Up,Right}
	bspc node -s {west,south,north,east}

# =============================================================================
# Layouts & Window States
# =============================================================================

# Toggle Floating state (i3 default: Super + Shift + Space)
super + shift + space
	bspc node -t \~floating

# Toggle Fullscreen (i3 default: Super + f)
super + f
	bspc node -t \~fullscreen

# Set split directional presel (horizontal / vertical split like i3's Mod+h / Mod+v)
super + b
	bspc node -p west
super + v
	bspc node -p south

# Cancel presel split
super + ctrl + space
	bspc query -N -d | xargs -I id bspc node id -p cancel

# Toggle layout modes (Tiling / Monocle/Tabbed)
super + s
	bspc desktop -l next

# Toggle Pseudo-Tiled state
super + shift + p
	bspc node -t \~pseudo_tiled

# Toggle Window Flags (Sticky / Locked / Private)
super + alt + {s,l,p}
	bspc node -g {sticky,locked,private}

# =============================================================================
# Workspaces (Focus & Send)
# =============================================================================

# Switch to workspace 1-9
super + {1-9,0}
	bspc desktop -f '^{1-9,10}'

# Send window to workspace 1-9
super + shift + {1-9,0}
	bspc node -d '^{1-9,10}'

# Switch to previous / next workspace
super + {comma,period}
	bspc desktop -f {prev,next}.local

# =============================================================================
# Window Resizing (i3 Resize Mode Emulation)
# =============================================================================

# Resize window edges with Alt + hjkl
super + alt + {h,j,k,l}
	bspc node -z {left -20 0,bottom 0 20,top 0 -20,right 20 0}

super + alt + shift + {h,j,k,l}
	bspc node -z {right -20 0,top 0 20,bottom 0 -20,left 20 0}

# =============================================================================
# Media & Hardware Keys (Volume & Brightness)
# =============================================================================

# Audio Volume Controls
XF86AudioRaiseVolume
	pactl set-sink-volume @DEFAULT_SINK@ +10%

XF86AudioLowerVolume
	pactl set-sink-volume @DEFAULT_SINK@ -10%

XF86AudioMute
	pactl set-sink-mute @DEFAULT_SINK@ toggle

XF86AudioMicMute
	pactl set-source-mute @DEFAULT_SOURCE@ toggle

# Screen Brightness Controls
XF86MonBrightnessUp
	brightnessctl s +5%

XF86MonBrightnessDown
	brightnessctl s 5%-
