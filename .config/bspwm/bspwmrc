#!/usr/bin/sh

sxhkd &

 bspc monitor -d I II III IV V VI VII VIII IX X

# Alternate labels
# bspc monitor -d "α" "β" "γ" "δ" "ε" "ζ" "η" "θ" "ι"


bspc config border_width         2
bspc config window_gap          6

bspc config split_ratio          0.52
bspc config borderless_monocle   true
bspc config gapless_monocle      true

bspc rule -a Gimp desktop='^8' state=floating follow=on
bspc rule -a Chromium desktop='^2'
bspc rule -a mplayer2 state=floating
bspc rule -a Kupfer.py focus=on
bspc rule -a Screenkey manage=off

# Window Border Colors (matching your i3 scheme)
bspc config focused_border_color     "#005577"
bspc config normal_border_color      "#222222"
bspc config active_border_color      "#222222"
bspc config presel_feedback_color   "#023c50"

# Border Layout Settings
bspc config border_width             2

# Prevent duplicate processes on bspwm reload
pgrep -x sxhkd > /dev/null || sxhkd &
pgrep -x picom > /dev/null || picom -b &

# Launch Polybar
$HOME/.config/polybar/launch.sh &

# Set wallpaper (if using feh or nitrogen)
# ~/.fehbg &
nitrogen --restore &
# Autostart applications

# Network Manager applet (systray)
pgrep -x nm-applet > /dev/null || nm-applet &

# Bluetooth applet (systray)
pgrep -x blueman-applet > /dev/null || blueman-applet &

# Screenshot tool daemon
pgrep -x flameshot > /dev/null || flameshot &

# Slock
xss-lock -- slock &
xset s 300 300  # Sets X screen saver timeout to 300 seconds
